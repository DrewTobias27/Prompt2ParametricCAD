{
  "description": "Exploratory prompt cases with concept-level expectations. These check whether generated CAD contains the main requested design ideas without requiring exact dimensions for underspecified prompts.",
  "cases": [
    {
      "name": "shaft_collar_groove",
      "prompt": "Create a 20 mm diameter shaft, 80 mm long, with a raised collar in the middle and a narrow groove near one end.",
      "focus": "Revolved base, add_revolve collar, cut_revolve groove",
      "expected_intent": {
        "base": {
          "profile": "cylinder"
        },
        "features": [
          {
            "operation": "revolved_extrusion",
            "shape": "rectangle",
            "placement": {
              "type": "centered"
            }
          },
          {
            "operation": "revolved_cut",
            "shape": "rectangle"
          }
        ]
      },
      "expected_concepts": {
        "base": {
          "type": "revolve",
          "angle": 360
        },
        "operations": [
          {
            "type": "add_revolve",
            "profile": "rectangle"
          },
          {
            "type": "cut_revolve",
            "profile": "rectangle"
          }
        ],
        "geometry": {
          "solid_count": 1,
          "bounding_box": {
            "xlen": {
              "approx": 20,
              "tolerance": 12
            },
            "ylen": {
              "approx": 80,
              "tolerance": 12
            }
          }
        }
      }
    },
    {
      "name": "half_cylinder_tab",
      "prompt": "Create a half-cylinder base, 80 mm long and 30 mm diameter, with a rectangular mounting tab on the flat face.",
      "focus": "Partial revolve or half-cylinder base with feature on flat face",
      "expected_intent": {
        "base": {
          "profile": "half_cylinder"
        },
        "features": [
          {
            "operation": "extrusion",
            "shape": "rectangle"
          }
        ]
      },
      "expected_concepts": {
        "base": {
          "type": "revolve",
          "angle": 180
        },
        "operations": [
          {
            "type": "add_extrude",
            "profile": "rectangle"
          }
        ],
        "geometry": {
          "solid_count": 1
        }
      }
    },
    {
      "name": "capsule_cylinder",
      "prompt": "Create a capsule-shaped cylinder with hemispherical ends, 20 mm diameter and 80 mm long.",
      "focus": "Revolved sketch profile with true arcs",
      "expected_intent": {
