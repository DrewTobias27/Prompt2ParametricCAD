      "prompt": "Create an L-shaped plate, 100 mm by 70 mm overall, 8 mm thick, with two circular holes on the long arm.",
      "focus": "Arbitrary polyline or sketch base and holes placed on a named region",
      "expected_concepts": {
        "base": {
          "type": "extrude"
        },
        "operations": [
          {
            "type": "cut",
            "profile": "circle"
