      "expected_concepts": {
        "base": {
          "type": "revolve",
          "profile": "sketch",
          "angle": 360
        },
        "geometry": {
          "solid_count": 1,
          "bounding_box": {
            "xlen": {
              "approx": 20,
              "tolerance": 4
            },
            "ylen": {
              "approx": 80,
              "tolerance": 6
            }
          }
        }
      }
    },
    {
