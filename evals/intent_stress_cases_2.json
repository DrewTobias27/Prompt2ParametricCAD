{
  "description": "Second exploratory stress suite for testing prompt-to-intent robustness across nested features, side-face targets, edge treatments after cuts, revolved details, and ambiguous engineering relationships.",
  "cases": [
    {
      "name": "boss_on_boss_cross_hole",
      "prompt": "Create a rectangular base plate with a raised rectangular boss centered on top, a smaller circular boss centered on that boss, and a horizontal circular hole through the rectangular boss.",
      "focus": "Nested feature targets and side-face cut through a previous feature",
      "expected_intent": {
        "base": {
          "profile": "rectangle"
        },
        "features": [
          {
            "operation": "extrusion",
            "shape": "rectangle",
            "placement": {
              "type": "centered"
            }
          },
          {
            "operation": "extrusion",
            "shape": "circle",
            "placement": {
              "type": "centered"
            }
          },
          {
            "operation": "cut",
            "shape": "circle"
          }
        ]
      },
      "expected_concepts": {
        "base": {
          "type": "extrude",
          "profile": "rectangle"
        },
        "min_operation_counts": {
          "add_extrude": 2,
          "cut": 1
        },
        "operations": [
          {
            "type": "add_extrude",
            "profile": "rectangle"
          },
          {
            "type": "add_extrude",
            "profile": "circle"
          },
          {
            "type": "cut",
            "profile": "circle"
          }
        ],
        "geometry": {
          "solid_count": 1
        }
      }
    },
    {
      "name": "obround_flange_tabs",
      "prompt": "Create an obround mounting flange with rounded ends, two circular through holes along its long axis, and small rectangular tabs extending from the left and right sides.",
